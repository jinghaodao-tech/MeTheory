{
  "package_name": "metheory_ai_templates",
  "version": "1.1.0",
  "locale": "ja-JP",
  "responsibility_boundary": {
    "system_owns": ["observed_fact", "evidence_direction", "hypothesis_status", "notification_schedule"],
    "ai_may_propose": ["bounded_interpretation", "hypothesis_candidate", "question_candidate"],
    "ai_must_not_decide": ["diagnosis", "causality", "personality", "evidence_strength", "self_model_update"]
  },
  "templates": [
    {
      "template_name": "pm_nl_structurer_v1",
      "purpose": "Convert free text into candidate observations without creating facts.",
      "developer_instructions": [
        "Return only fields from allowed_taxonomies.",
        "Use source_span and certainty for every candidate observation.",
        "Use user_confirmed only when the user explicitly confirmed the value; otherwise use ai_inferred and needs_confirmation=true.",
        "Never diagnose, assert personality, infer causality, or add facts not present in raw_text.",
        "Do not produce observedFact, evidence direction, hypothesis status, or notification timing decisions."
      ],
      "input_schema": {
        "type": "object", "additionalProperties": false,
        "required": ["locale", "raw_text", "allowed_taxonomies", "context"],
        "properties": {
          "locale": { "type": "string", "enum": ["ja-JP"] },
          "raw_text": { "type": "string", "minLength": 1 },
          "allowed_taxonomies": { "type": "object", "additionalProperties": false, "required": ["activity_categories", "outcome_labels", "state_fields"], "properties": { "activity_categories": { "type": "array", "items": { "type": "string" } }, "outcome_labels": { "type": "array", "items": { "type": "string" } }, "state_fields": { "type": "array", "items": { "type": "string" } } } },
          "context": { "type": "object", "additionalProperties": false, "required": ["timestamp_local", "user_timezone"], "properties": { "timestamp_local": { "type": "string" }, "user_timezone": { "type": "string" }, "recent_plans": { "type": "array", "items": { "type": "string" } } } }
        }
      },
      "output_schema": {
        "type": "object", "additionalProperties": false, "required": ["status", "observations", "ambiguities"],
        "properties": {
          "status": { "type": "string", "enum": ["ok", "needs_confirmation", "unparsable"] },
          "observations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["field", "value", "source_span", "certainty", "source", "needs_confirmation"], "properties": { "field": { "type": "string" }, "value": { "type": ["string", "number", "boolean", "null"] }, "source_span": { "type": "string" }, "certainty": { "type": "string", "enum": ["high", "medium", "low"] }, "source": { "type": "string", "enum": ["user_confirmed", "ai_inferred"] }, "needs_confirmation": { "type": "boolean" } } } },
          "ambiguities": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["question", "reason"], "properties": { "question": { "type": "string" }, "reason": { "type": "string" } } } }
        }
      }
    },
    {
      "template_name": "pm_hypothesis_generator_v1",
      "purpose": "Propose up to three testable hypothesis candidates from system-provided facts.",
      "developer_instructions": [
        "Treat observed facts as read-only input.",
        "Return at most three candidates and map each to an allowed template.",
        "Do not change evidence direction, confidence, hypothesis status, or the Self Model.",
        "Do not add diagnosis, personality labels, causal claims, or unsupported attributes.",
        "Every candidate must include a validation condition and an alternative explanation."
      ],
      "input_schema": { "type": "object", "additionalProperties": false, "required": ["locale", "facts", "self_beliefs", "allowed_templates", "allowed_fields"], "properties": { "locale": { "type": "string", "enum": ["ja-JP"] }, "facts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["fact_id", "fact_type", "statement", "numbers"], "properties": { "fact_id": { "type": "string" }, "fact_type": { "type": "string", "enum": ["difference", "mismatch", "exception", "data_gap"] }, "statement": { "type": "string" }, "numbers": { "type": "array", "items": { "type": "number" } } } } }, "self_beliefs": { "type": "array", "items": { "type": "string" } }, "allowed_templates": { "type": "array", "items": { "type": "string" } }, "allowed_fields": { "type": "array", "items": { "type": "string" } } } },
      "output_schema": { "type": "object", "additionalProperties": false, "required": ["status", "hypotheses"], "properties": { "status": { "type": "string", "enum": ["ok", "no_candidate", "needs_more_data"] }, "hypotheses": { "type": "array", "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["template_key", "statement", "required_observations", "alternative_explanation", "validation_condition"], "properties": { "template_key": { "type": "string" }, "statement": { "type": "string" }, "required_observations": { "type": "array", "items": { "type": "string" } }, "alternative_explanation": { "type": "string" }, "validation_condition": { "type": "string" }, "risk_notes": { "type": "array", "items": { "type": "string" } } } } } } }
    },
    {
      "template_name": "pm_next_question_suggester_v1",
      "purpose": "Suggest one bounded question candidate for system validation.",
      "developer_instructions": [
        "Return one question candidate only.",
        "Never choose a notification time or frequency.",
        "Use only allowed question types and missing fields.",
        "Avoid diagnostic, personality, causal, or sensitive wording."
      ],
      "input_schema": { "type": "object", "additionalProperties": false, "required": ["locale", "hypothesis", "missing_fields", "allowed_question_types"], "properties": { "locale": { "type": "string", "enum": ["ja-JP"] }, "hypothesis": { "type": "string" }, "missing_fields": { "type": "array", "items": { "type": "string" } }, "allowed_question_types": { "type": "array", "items": { "type": "string", "enum": ["single_choice", "yes_no", "number", "scale"] } } } },
      "output_schema": { "type": "object", "additionalProperties": false, "required": ["status", "question"], "properties": { "status": { "type": "string", "enum": ["ok", "no_safe_question"] }, "question": { "type": "object", "additionalProperties": false, "required": ["question_text", "question_type", "field", "options"], "properties": { "question_text": { "type": "string" }, "question_type": { "type": "string" }, "field": { "type": "string" }, "options": { "type": "array", "items": { "type": "string" } }, "privacy_note": { "type": "string" } } } } }
    },
    {
      "template_name": "pm_safe_explanation_renderer_v1",
      "purpose": "Render system-computed facts and bounded interpretations without strengthening them.",
      "developer_instructions": [
        "Preserve every number, comparison direction, sample size, and limitation exactly.",
        "Separate observedFact, boundedInterpretation, and hypothesisCandidate.",
        "Do not invent facts, motives, attributes, causality, diagnosis, or personality labels.",
        "Use a neutral fallback when the evaluation is insufficient or unsupported.",
        "The system owns evidence direction and hypothesis status; do not output replacement values."
      ],
      "input_schema": { "type": "object", "additionalProperties": false, "required": ["locale", "observed_fact", "bounded_interpretation", "hypothesis_candidate", "evaluation", "evidence"], "properties": { "locale": { "type": "string", "enum": ["ja-JP"] }, "observed_fact": { "type": "string" }, "bounded_interpretation": { "type": ["string", "null"] }, "hypothesis_candidate": { "type": ["string", "null"] }, "evaluation": { "type": "string", "enum": ["supported", "challenged", "inconclusive"] }, "evidence": { "type": "object", "additionalProperties": false, "required": ["sample_size", "summary"], "properties": { "sample_size": { "type": "integer" }, "summary": { "type": "string" }, "limitations": { "type": "array", "items": { "type": "string" } } } } } },
      "output_schema": { "type": "object", "additionalProperties": false, "required": ["status", "observedFact", "boundedInterpretation", "hypothesisCandidate", "safetyFlags"], "properties": { "status": { "type": "string", "enum": ["ok", "fallback_required"] }, "observedFact": { "type": "string" }, "boundedInterpretation": { "type": ["string", "null"] }, "hypothesisCandidate": { "type": ["string", "null"] }, "safetyFlags": { "type": "array", "items": { "type": "string" } } } }
    }
  ]
}
