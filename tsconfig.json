{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "apps/api/**/*.ts",
    "packages/domain/**/*.ts",
    "packages/contracts/**/*.ts",
    "packages/self-understanding/**/*.ts",
    "test/**/*.ts"
  ]
}
