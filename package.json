{
  "name": "metheory",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "dev:api": "node --experimental-strip-types apps/api/src/server.ts",
    "demo": "node apps/demo-web/server.mjs",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "doctor:mobile": "cd apps/mobile && npx expo-doctor",
    "test:domain": "node --experimental-strip-types --test test/domain.test.ts",
    "test:hypothesis": "node --experimental-strip-types --test test/hypothesis-evaluation.test.ts",
    "test:candidates": "node --experimental-strip-types --test test/hypothesis-candidates.test.ts",
    "test:source-adapters": "node --experimental-strip-types --test test/source-adapters.test.ts",
    "test:completion": "node --experimental-strip-types --test test/completion-engine.test.ts",
    "test:benchmark": "node --experimental-strip-types --test test/performance-benchmark.test.ts",
    "test:api": "node --experimental-strip-types --test test/api-ai.test.ts",
    "test:entries": "node --experimental-strip-types --test test/entries.test.ts",
    "test:templates": "node --experimental-strip-types --test test/template-domain.test.ts",
    "test:workspace": "node --experimental-strip-types --test test/workspace-sync.test.ts",
    "test:ai-provider": "node --experimental-strip-types --test test/ai-provider.test.ts",
    "test:local-ai-runtime": "node --experimental-strip-types --test test/local-ai-runtime.test.ts",
    "test:entry-extraction": "node --experimental-strip-types --test test/entry-extraction.test.ts",
    "test:privacy": "node --experimental-strip-types --test test/privacy.test.ts",
    "test:self-understanding": "node --experimental-strip-types --test test/self-understanding.test.ts",
    "test:external-assets": "node --experimental-strip-types --test test/external-assets.test.ts",
    "test:search": "node --experimental-strip-types --test test/search-core.test.ts",
    "test:pcs-analysis-v2": "node --experimental-strip-types --test test/pcs-analysis-v2.test.ts",
    "test:pcs-e2e": "node --experimental-strip-types --test test/pcs-e2e.test.ts",
    "test:pcs-client": "node --experimental-strip-types --test test/pcs-client.test.ts",
    "test:pcs-live-stub": "node --experimental-strip-types --test test/pcs-live-stub.test.ts",
    "test:pcs-migration": "node --experimental-strip-types --test test/pcs-migration.test.ts",
    "test:pcs-experiment": "node --experimental-strip-types --test test/pcs-experiment-repository.test.ts",
    "test:review-bridge": "npm --prefix review-bridge test",
    "test:review-trigger": "npm --prefix review-trigger test",
    "test:ai-service": "node --experimental-strip-types --test test/ai-query-service.test.ts",
    "check:openapi": "node --experimental-strip-types tools/validate-openapi.ts",
    "benchmark:small": "node --experimental-strip-types tools/benchmark-sqlite.ts small",
    "benchmark:medium": "node --experimental-strip-types tools/benchmark-sqlite.ts medium",
    "benchmark:large": "node --experimental-strip-types tools/benchmark-sqlite.ts large",
    "benchmark": "npm run benchmark:small && npm run benchmark:medium && npm run benchmark:large",
    "seed:synthetic": "node --experimental-strip-types tools/synthetic-scenarios.ts seed",
    "test:synthetic": "npm run seed:synthetic && node --experimental-strip-types tools/synthetic-scenarios.ts test",
    "reset:synthetic": "node --experimental-strip-types tools/synthetic-scenarios.ts reset",
    "test": "npm run test:domain && npm run test:hypothesis && npm run test:candidates && npm run test:source-adapters && npm run test:completion && npm run test:benchmark && npm run test:ai-service && npm run test:api && npm run test:entries && npm run test:templates && npm run test:workspace && npm run test:ai-provider && npm run test:local-ai-runtime && npm run test:entry-extraction && npm run test:privacy && npm run test:self-understanding && npm run test:external-assets && npm run test:review-trigger && npm run test:review-bridge && npm run test:search && npm run test:pcs-analysis-v2 && npm run test:pcs-e2e && npm run test:pcs-client && npm run test:pcs-live-stub && npm run test:pcs-migration && npm run test:pcs-experiment",
    "test:mobile": "npm --workspace apps/mobile run test",
    "typecheck:root": "tsc --project tsconfig.json",
    "typecheck:mobile": "npm --workspace apps/mobile run typecheck",
    "typecheck:obsidian": "tsc --project apps/obsidian-plugin/tsconfig.json",
    "typecheck": "npm run typecheck:root && npm run typecheck:mobile && npm run typecheck:obsidian",
    "build:obsidian": "node apps/obsidian-plugin/esbuild.mjs",
    "build:cli": "tsc --project apps/cli/tsconfig.json",
    "build:vscode": "npm --prefix apps/vscode-extension run build",
    "typecheck:vscode": "npm --prefix apps/vscode-extension run typecheck",
    "check": "node --check apps/api/src/server.ts && node --check packages/domain/src/index.ts && node --check apps/obsidian-plugin/main.js && npm run check:openapi",
    "typecheck:cli": "tsc --project apps/cli/tsconfig.json",
    "verify": "npm run typecheck && npm run typecheck:cli && npm run typecheck:vscode && npm run build:obsidian && npm run build:cli && npm run build:vscode && npm run test && npm run test:mobile && npm run test:synthetic && npm run check"
    ,"verify:ci": "npm run typecheck:root && npm test && npm run check:openapi"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
