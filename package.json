{
    "name":  "metheory",
    "private":  true,
    "type":  "module",
    "workspaces":  [
                       "apps/mobile"
                   ],
    "scripts":  {
                    "dev:api":  "node --experimental-strip-types apps/api/src/server.ts",
                    "dev:mobile":  "npm --workspace apps/mobile run start",
                    "doctor:mobile":  "cd apps/mobile \u0026\u0026 npx expo-doctor",
                    "test:domain":  "node --experimental-strip-types --test test/domain.test.ts",
                    "test:hypothesis":  "node --experimental-strip-types --test test/hypothesis-evaluation.test.ts",
                    "test:candidates":  "node --experimental-strip-types --test test/hypothesis-candidates.test.ts",
                    "test:source-adapters":  "node --experimental-strip-types --test test/source-adapters.test.ts",
                    "test:completion":  "node --experimental-strip-types --test test/completion-engine.test.ts",
                    "test:benchmark":  "node --experimental-strip-types --test test/performance-benchmark.test.ts",
                    "test:api":  "node --experimental-strip-types --test test/api-ai.test.ts",
                    "test:self-understanding":  "node --experimental-strip-types --test test/self-understanding.test.ts",
                    "test:external-assets":  "node --experimental-strip-types --test test/external-assets.test.ts",
                    "test:ai-service":  "node --experimental-strip-types --test test/ai-query-service.test.ts",
                    "check:openapi":  "node --experimental-strip-types tools/validate-openapi.ts",
                    "check:encoding":  "node scripts/check-encoding.mjs",
                    "benchmark:small":  "node --experimental-strip-types tools/benchmark-sqlite.ts small",
                    "benchmark:medium":  "node --experimental-strip-types tools/benchmark-sqlite.ts medium",
                    "benchmark:large":  "node --experimental-strip-types tools/benchmark-sqlite.ts large",
                    "benchmark":  "npm run benchmark:small \u0026\u0026 npm run benchmark:medium \u0026\u0026 npm run benchmark:large",
                    "seed:synthetic":  "node --experimental-strip-types tools/synthetic-scenarios.ts seed",
                    "test:synthetic":  "npm run seed:synthetic \u0026\u0026 node --experimental-strip-types tools/synthetic-scenarios.ts test",
                    "reset:synthetic":  "node --experimental-strip-types tools/synthetic-scenarios.ts reset",
                    "test":  "npm run test:domain \u0026\u0026 npm run test:hypothesis \u0026\u0026 npm run test:candidates \u0026\u0026 npm run test:source-adapters \u0026\u0026 npm run test:completion \u0026\u0026 npm run test:benchmark \u0026\u0026 npm run test:ai-service \u0026\u0026 npm run test:api \u0026\u0026 npm run test:self-understanding \u0026\u0026 npm run test:pcs-client \u0026\u0026 npm run test:pcs-cross-repository \u0026\u0026 npm run test:pcs-snapshot \u0026\u0026 npm run test:demo-web \u0026\u0026 npm run test:experiments \u0026\u0026 npm run test:external-assets",
                    "test:mobile":  "npm --workspace apps/mobile run test",
                    "typecheck:root":  "tsc --project tsconfig.json",
                    "typecheck:mobile":  "npm --workspace apps/mobile run typecheck",
                    "typecheck":  "npm run typecheck:root \u0026\u0026 npm run typecheck:mobile",
                    "build:cli":  "tsc --project apps/cli/tsconfig.json",
                    "check":  "node --check apps/api/src/server.ts \u0026\u0026 node --check packages/domain/src/index.ts \u0026\u0026 npm run check:openapi \u0026\u0026 npm run check:encoding",
                    "typecheck:cli":  "tsc --project apps/cli/tsconfig.json",
                    "verify:ci":  "npm ci \u0026\u0026 npm run verify",
                    "verify":  "npm run typecheck \u0026\u0026 npm run typecheck:cli \u0026\u0026 npm run build:cli \u0026\u0026 npm run test \u0026\u0026 npm run test:mobile \u0026\u0026 npm run test:synthetic \u0026\u0026 npm run check",
                    "test:pcs-client":  "node --experimental-strip-types --test test/pcs-client.test.ts",
                    "test:pcs-cross-repository":  "node --experimental-strip-types --test test/pcs-cross-repository.test.ts",
                    "test:pcs-snapshot":  "node --experimental-strip-types --test test/pcs-snapshot.test.ts",
                    "test:e2e:closed-loop":  "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/closed-loop-e2e.ps1",
                    "test:demo-web":  "node --test test/demo-web.test.mjs",
                    "test:experiments":  "node --experimental-strip-types --test test/experiments.test.ts test/experiments-api.test.ts test/closed-loop-synthetic.test.ts"
                },
    "engines":  {
                    "node":  "\u003e=24.0.0"
                },
    "devDependencies":  {
                            "@types/node":  "^26.1.1",
                            "typescript":  "^7.0.2"
                        }
}
