{
  "name": "metheory",
  "private": true,
  "type": "module",
  "workspaces": ["apps/mobile"],
  "scripts": {
    "dev:api": "node --experimental-strip-types apps/api/src/server.ts",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "doctor:mobile": "cd apps/mobile && npx expo-doctor",
    "test:domain": "node --experimental-strip-types --test test/domain.test.ts",
    "test:hypothesis": "node --experimental-strip-types --test test/hypothesis-evaluation.test.ts",
    "test:candidates": "node --experimental-strip-types --test test/hypothesis-candidates.test.ts",
    "test:source-adapters": "node --experimental-strip-types --test test/source-adapters.test.ts",
    "test:completion": "node --experimental-strip-types --test test/completion-engine.test.ts",
    "test:benchmark": "node --experimental-strip-types --test test/performance-benchmark.test.ts",
    "test": "npm run test:domain && npm run test:hypothesis && npm run test:candidates && npm run test:source-adapters && npm run test:completion && npm run test:benchmark",
    "test:mobile": "npm --workspace apps/mobile run test",
    "typecheck:mobile": "npm --workspace apps/mobile run typecheck",
    "typecheck": "npm run typecheck:mobile",
    "check": "node --check apps/api/src/server.ts && node --check packages/domain/src/index.ts",
    "verify": "npm run typecheck && npm run test && npm run test:mobile && npm run check"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
